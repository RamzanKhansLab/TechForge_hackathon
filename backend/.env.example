NODE_ENV=development
PORT=8000
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/skillproof?retryWrites=true&w=majority
CLIENT_ORIGIN=http://localhost:5173
GITHUB_TOKEN=
GITHUB_API_VERSION=2022-11-28
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_REPOSITORIES=6
MAX_FILE_SIZE_MB=5
GITHUB_CACHE_TTL_SECONDS=900
TRUST_PROXY=0
JWT_SECRET=replace-with-a-random-32-character-minimum-secret
REFRESH_SECRET=replace-with-a-different-random-32-character-minimum-secret
COOKIE_SECRET=replace-with-a-random-32-character-minimum-secret
# Set true in production. Production startup refuses false or default JWT/refresh secrets.
COOKIE_SECURE=false
